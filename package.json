{
  "name": "easy-grab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "node server/index.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:manifest": "node scripts/build-manifest.mjs",
    "security:check": "node scripts/security-check.mjs",
    "verify": "npm run build && npm run build:manifest && npm audit --omit=dev && npm run security:check"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.2",
    "bs58": "^6.0.0",
    "qrcode": "^1.5.4",
    "vite": "^8.1.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.8.3"
  }
}

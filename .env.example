# Easy Grab browser env.
# Do not put private keys, wallet seed phrases, or claim secrets in Vite env files.

# Local development:
VITE_PUBLIC_APP_URL=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8787

# Mainnet RPC endpoint. Use the full provider URL, including the API key query string.
VITE_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Optional devnet override.
VITE_DEVNET_RPC_URL=https://api.devnet.solana.com

# Encrypted history API server env.
# Use HOST=127.0.0.1 behind an HTTPS reverse proxy, or HOST=0.0.0.0 only when the host firewall and proxy are configured.
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGIN=http://127.0.0.1:5173
MAX_BODY_BYTES=1000000
